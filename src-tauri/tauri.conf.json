{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wejet",
  "version": "1.0.0",
  "identifier": "com.wejet.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "desktop",
        "title": "Wejet Desktop Layer",
        "url": "index.html?window=desktop",
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "skipTaskbar": true,
        "visible": true,
        "focus": false,
        "x": 0,
        "y": 0,
        "width": 1920,
        "height": 1080
      },
      {
        "label": "manager",
        "title": "Wejet — Desktop Control Center",
        "url": "index.html?window=manager",
        "decorations": true,
        "transparent": true,
        "shadow": true,
        "resizable": true,
        "center": true,
        "visible": true,
        "width": 1180,
        "height": 780,
        "minWidth": 920,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: https://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost https://api.open-meteo.com https://geocoding-api.open-meteo.com https://api.coingecko.com https://open.er-api.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "category": "Utility",
    "shortDescription": "Lightweight glass personal desktop environment for Windows",
    "longDescription": "Wejet turns the Windows desktop into a fast, customizable personal workspace with translucent glass widgets, Command Center, Spaces, Jalali calendar, system telemetry, media controls, and quick tools.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "allowDowngrades": true,
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      },
      "wix": {
        "language": "en-US"
      }
    }
  }
}
